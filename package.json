{
  "name": "mara-os",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Mara OS — операционная система виртуального AI-креатора: фан-база, диалоги с human-in-the-loop AI, контент, офферы, выручка, аналитика и Telegram-компаньон",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --base /MoraOS-v2/",
    "typecheck": "tsc -b --noEmit",
    "test": "node scripts/test.mjs",
    "bot:start": "node bot/server.mjs",
    "bot:local": "node --env-file=bot/.env bot/server.mjs",
    "bot:test": "node --test tests/telegram.test.mjs",
    "check": "npm run typecheck && npm test && npm run smoke && npm run build && npm run check:dist",
    "smoke": "node scripts/smoke-demo.mjs && node scripts/smoke-build.mjs && node scripts/smoke-telegram-config.mjs && node scripts/smoke-telegram-api.mjs && node scripts/smoke-telegram-setup.mjs",
    "supabase:auth": "node scripts/supabase-auth-setup.mjs",
    "bot:setup": "node scripts/telegram-bot-setup.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "bot:menu": "node scripts/telegram-bot-setup.mjs --menu-only",
    "e2e": "node scripts/e2e-mini-app.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@supabase/supabase-js": "^2.109.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "@twa-dev/sdk": "^8.0.2",
    "@types/node": "^26.6.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "vite": "^7.3.2"
  }
}
