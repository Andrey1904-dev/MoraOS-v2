# Сервер Telegram Assistant — секреты держать только в переменных окружения хостинга
TELEGRAM_BOT_TOKEN=123456:replace-with-token-from-botfather

SUPABASE_URL=https://dcgurmwvpgzmlfivxoso.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Тот же файл подходит и для Supabase Edge Function (вариант с webhook):
# те же переменные кладутся в секреты функции (supabase secrets set), а
# TELEGRAM_WEBHOOK_SECRET задаёт подпись, с которой Telegram присылает
# обновления (scripts/telegram-bot-setup.mjs делает это автоматически).

# Публичный HTTPS-адрес сайта = URL Telegram Mini App: кнопка меню «Кабинет» и
# inline-кнопки «Открыть кабинет» (тип web_app). Hash (#/…) отбрасывается.
# Пусто или http:// — кнопки кабинета не показываются, меню остаётся списком команд.
WEB_APP_URL=https://andrey1904-dev.github.io/MoraOS-v2/

# Разрешённые origin сайта для браузерного API; URL из WEB_APP_URL разрешён автоматически.
CORS_ALLOWED_ORIGINS=
# Только для локальной разработки: разрешить http://localhost:5173 и 127.0.0.1:5173.
# В продакшне оставьте пустым.
ALLOW_LOCAL_ORIGINS=
PORT=3001

# Серверный AI-провайдер (OpenAI-совместимый endpoint: OpenAI, Groq, Together,
# DeepSeek и т.п.). Без AI_API_KEY команды /ai → «Ideas» и «Briefings» честно
# отвечают «провайдер не настроен» — никаких выдуманных результатов.
# Эти переменные SERVER-ONLY: в браузерную сборку (VITE_*) они не попадают.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Дайджест-уведомления владельцу (scripts/telegram-notify.mjs, запуск по cron).
# Минимальный интервал между сообщениями в один чат, минут:
NOTIFY_MIN_INTERVAL_MINUTES=30
