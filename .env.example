# Скопируйте этот файл в .env и подставьте ключи вашего проекта Supabase
# (Project Settings → API → Project URL / anon public key)
#
# Без этих переменных приложение автоматически работает в локальном
# демо-режиме (данные хранятся в localStorage браузера).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Telegram — публичные настройки сайта (НЕ вставляйте сюда токен бота!)
#   VITE_TELEGRAM_BOT_USERNAME — публичное имя бота без @, например MaraOSAssistant_bot
#   VITE_TELEGRAM_API_URL      — HTTPS-адрес API бота. В задеплоенной сборке это
#     полный адрес, например https://<project-ref>.supabase.co/functions/v1/telegram-api
#     (так работает Supabase Edge Function из supabase/functions/telegram-api).
#     Относительный /telegram-api допустим только локально: Vite проксирует его
#     на серверный порт 3001.
# Токен BotFather хранится в секретах сервиса бота (bot/.env, supabase secrets),
# а не здесь: всё из VITE_* попадает в открытый JS-бандл сайта.
VITE_TELEGRAM_BOT_USERNAME=
VITE_TELEGRAM_API_URL=/telegram-api
